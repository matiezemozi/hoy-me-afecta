  "notices": [
    {
      "id": "agua-27947888842247a5bc",
      "category": "agua",
      "country": "Argentina",
      "province": "Río Negro",
      "company": "Aguas Rionegrinas",
      "kind": "water_service_bulletin",
      "status": "publication_only_not_live",
      "locality_hint": "Bariloche",
      "zone_detail": "Aguas Rionegrinas informa que personal del servicio local de Bariloche solucionó durante esta mañana inconvenientes registrados en una válvula de distribución de agua potable. Gracias a la intervención del personal, la red comenzó a recuperar presión y los vecinos empezaron a contar nuevamente con el recurso. Se estima a partir de las 14 hs ya este solucionado en su totalidad. Mientras se completa la normalización del servicio, podrían registrarse baja presión o faltante de agua en los barrios Las Margaritas, Jardín Botánico, Altos del Jardín Botánico y Belgrano. Aguas Rionegrinas destaca el trabajo realizado por sus equipos para resolver la situación y restablecer el servicio. La recuperación de la presión será paulatina hasta alcanzar la normalización total. Ante cualquier consulta o reclamo, los usuarios pueden comunicarse a través de WhatsApp al 2920 402808 o al 0800 999 24827 .",
      "source_url": "https://aguasrionegrinas.com/bariloche-arsa-soluciono-inconvenientes-en-valvulas-y-comenzo-la-recuperacion-de-presion-en-la-red-de-agua/",
      "notification_allowed": false,
      "message": "Comunicado oficial; no acredita el estado del suministro en tiempo real.",
      "published_on": "2026-11-21",
      "scheduled_start": null,
      "scheduled_end": null
    },
    {
      "id": "agua-6f53381fce1b3bcfa1",
      "category": "agua",
      "country": "Argentina",
      "province": "Río Negro",
      "company": "Aguas Rionegrinas",
      "kind": "water_service_bulletin",
      "status": "publication_only_not_live",
      "locality_hint": "El Bolsón",
      "zone_detail": "Aguas Rionegrinas informa que personal del servicio local de El Bolsón trabaja desde las 9 de este domingo 22 de noviembre en la reparación de una cañería ubicada en la intersección de las calles Rivadavia y Ulieldin. Debido a estas tareas, se encuentra afectada la prestación del servicio de agua potable en el barrio Centro, en el sector comprendido entre las calles Balcarce y Güemes, donde se registra baja presión y podría producirse una falta temporal de suministro. Se preve que a partir de las 14 hs ya este normalizada la presión del suministro. La empresa trabaja para resolver la situación y restablecer el servicio con la mayor celeridad posible. Ante cualquier consulta, los usuarios pueden comunicarse a través del WhatsApp de Aguas Rionegrinas o al 0800-999-24827 .",
